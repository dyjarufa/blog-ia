{
  "name": "rocketseat-blog-ia-nodejs",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.js",
    "env:setup": "cp .env.example .env.local",
    "infra:up": "docker compose up --detach",
    "infra:down": "docker compose down",
    "migrate:up": "postgres migrate up",
    "migrate:down": "postgres migrate zero",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "docker build -t blog-api .",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/e2e/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@mastra/core": "^0.24.9",
    "nanoid": "^5.1.16",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "commitlint": "^20.5.3",
    "eslint": "^10.11.0",
    "lefthook": "^2.1.14",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
